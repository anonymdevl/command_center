  {"fieldname": "timezone", "fieldtype": "Data", "label": "Time Zone"},

  {"fieldname": "authority_section", "fieldtype": "Section Break", "label": "Owned Settings"},
  {"fieldname": "authority_note", "fieldtype": "HTML",
   "options": "<div class=\"text-muted small\">A business's settings are owned by the site that holds its data. On a peer's record these are shown as they were last read and cannot be edited here — so no figure is ever writable in two places, and there is nothing to reconcile.</div>"},
  {"fieldname": "overdue_after_days", "fieldtype": "Int", "label": "Overdue After (Days)",
