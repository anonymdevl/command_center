# The platform behind nginx, once it has a domain. deploy/platform.sh does not install
# this: copy it to /etc/nginx/sites-available/insights, set server_name, enable it,
# then `sudo certbot --nginx -d <domain>` for HTTPS.
server {
    listen 80;
    server_name insights.example.com;

    client_max_body_size 20m;

    # The built interface and images, straight from disk, cached for a year (their
    # names carry a content hash, so a new build is a new URL).
    location /assets/command_center/ {
        alias __DIR__/command_center/public/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    location /static/ {
        alias __DIR__/staticfiles/;
        expires 30d;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A deeper look can take minutes; Claude's answers stream for up to 150 s.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
