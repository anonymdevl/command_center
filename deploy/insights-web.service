# The platform's web service. Installed by deploy/platform.sh as
# /etc/systemd/system/insights-web.service (USER and DIR filled in).
[Unit]
Description=Insights platform (web)
After=network.target mariadb.service

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=INSIGHTS_CONFIG=__DIR__/insights.json
Environment=DJANGO_SETTINGS_MODULE=insights.settings
# One process, eight threads: a question can hold a thread for up to 150 s while Claude
# answers, and a request mostly waits (on the database or Claude), so threads, not
# processes, carry the load -- each extra process would cost ~140 MB on a shared
# server. Raise --workers when many more people use it. Timeout above the longest call.
ExecStart=__DIR__/.venv-platform/bin/gunicorn insights.wsgi:application \
    --bind 127.0.0.1:__PORT__ --workers 1 --threads 8 --timeout 240 --graceful-timeout 30 \
    --access-logfile - --error-logfile -
# Shares the server with ERPNext sites, which always come first: lower CPU and disk
# priority, and a memory ceiling (if it is reached, only this service is restarted).
Nice=10
CPUWeight=50
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=2G
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
